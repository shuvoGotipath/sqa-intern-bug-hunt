# Copy to .env and adjust. Real environment variables override this file.
PORT=3000
NODE_ENV=production

# Admin dashboard login (/admin). Password must be at least 12 characters in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# MongoDB (required) — Atlas or self-hosted
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
MONGODB_DB=sqa_hiring

# S3-compatible storage for CVs and screenshots (required in production).
# Without these, files are stored in ./uploads (development only).
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# UPLOAD_DIR=./uploads

# Set when running behind HTTPS / a reverse proxy (nginx, Render, Railway, ...)
SECURE_COOKIES=true
TRUST_PROXY=true
